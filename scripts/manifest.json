{
  "name": "SpectraLens AI",
  "version": "2.8.142",
  "description": "Fast multi-engine AI search aggregation, in-page text selection, and on-device Optical Character Recognition (OCR).",
  "manifest_version": 3,
  "permissions": [
    "scripting",
    "storage",
    "activeTab",
    "tabs",
    "offscreen"
  ],
  "optional_permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "./background/background.js"
  },
  "homepage_url": "https://github.com/elsesourav/spectralens-ai",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_globs": [
        "chrome://*"
      ],
      "run_at": "document_start",
      "js": [
        "./utils.js",
        "./content/enableCopy.js",
        "./content/providerAdapters.js",
        "./content/content.js",
        "./content/widgetContent.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "inject/*",
        "offscreen/*",
        "offscreen/OCR/*",
        "offscreen/OCR/Tesseract/*",
        "offscreen/OCR/Lang/*",
        "inject/selection.html",
        "inject/widgetWindow.html",
        "offscreen/offscreen.html",
        "utils.js",
        "content/providerAdapters.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "assets/icons/16.png",
      "24": "assets/icons/24.png",
      "32": "assets/icons/32.png",
      "48": "assets/icons/48.png",
      "128": "assets/icons/128.png"
    },
    "default_title": "SpectraLens AI",
    "default_popup": "./popup/popup.html"
  },
  "options_ui": {
    "page": "./options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/icons/16.png",
    "24": "assets/icons/24.png",
    "32": "assets/icons/32.png",
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  }
}
